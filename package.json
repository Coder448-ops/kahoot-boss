{
  "name": "kahoot-boss",
  "private": true,
  "version": "1.0.0",
  "description": "KAHOOT BOSS — Intelligence. Automation. Control. Premium AI-powered Kahoot test automation platform.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "prebuild": "npm run connector:bundle --silent && mkdir -p public && cp dist-connector/kb-connector.cjs public/kb-connector.cjs && echo staged public/kb-connector.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "server": "tsx watch server/index.ts",
    "server:start": "node dist-server/server/index.js",
    "server:build": "tsc -p tsconfig.server.json && echo '{\"type\":\"commonjs\"}' > dist-server/package.json && echo built dist-server",
    "connector:bundle": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist-connector/kb-connector.cjs --log-level=error && node -e \"console.log('bundled dist-connector/kb-connector.cjs')\"",
    "connector:test-bundle": "npm run connector:bundle && tsx server/kahoot/__tests__/bundle.test.ts",
    "test:live": "esbuild server/kahoot/__tests__/live.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/kb-live-test.cjs --log-level=error && node node_modules/.cache/kb-live-test.cjs",
    "test:direct": "esbuild server/kahoot/__tests__/direct.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/kb-direct-test.cjs --log-level=error && node node_modules/.cache/kb-direct-test.cjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "ws": "^8.23.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
