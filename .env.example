# KAHOOT BOSS — environment configuration
# Copy to `.env` and fill in. Never commit real keys.

# ---------- Web UI (Vite; VITE_* is exposed to the browser) ----------
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api
# Default live-connector base URL (overridable in Settings → Live connector).
# '/live' uses the Vite dev proxy (same origin). For a remote connector:
# VITE_LIVE_BACKEND_URL=https://your-connector.example.com/live
VITE_LIVE_BACKEND_URL=/live

# ---------- Cloud AI solver (serverless /api/solve) ----------
# Optional: OpenAI-compatible chat-completions endpoint for API solver mode.
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ---------- Live connector backend (server/; `npm run server`) ----------
PORT=3001
# Real Kahoot session infrastructure used by the official web client.
# Override only for tests or if Kahoot serves your region from another host.
KAHOOT_RESERVE_BASE=https://kahoot.it
KAHOOT_COMETD_BASE=wss://kahoot.it
# Login token sent with the join request (documented client value).
# Set empty to omit it: KAHOOT_CAPTCHA_TOKEN=
KAHOOT_CAPTCHA_TOKEN=KAHOOT_TOKEN_eyJ2ZXJzaW9uIjoiIn0=
KAHOOT_CLIENT_UA=KAHOOT-BOSS/1.0 (+https://github.com/Coder448-ops/kahoot-boss)
# CORS: '*' for dev, or a comma-separated allowlist in production.
ALLOWED_ORIGINS=*
# Timeouts (ms)
TIMEOUT_RESERVE_MS=12000
TIMEOUT_HANDSHAKE_MS=15000
TIMEOUT_LOGIN_MS=20000
TIMEOUT_JOIN_MS=60000
TIMEOUT_TWO_FACTOR_MS=20000
# Single-process deploy: serve the built frontend from the connector.
# SERVE_STATIC=1
# STATIC_DIR=dist
# Verbose protocol logging: KB_DEBUG=1
