# KAHOOT BOSS — environment configuration
# Copy to `.env` and fill in. Never commit real keys.

# Optional: OpenAI-compatible chat-completions endpoint for the API solver mode.
# Example: https://api.openai.com/v1
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: official / permitted live-game integration endpoint.
# Leave empty unless you have an authorized integration to configure.
# The app will honestly report "not configured" and keep simulation mode working.
LIVE_GAME_API_URL=
LIVE_GAME_API_KEY=

# Public flags (exposed to the browser via Vite)
VITE_APP_VERSION=1.0.0
VITE_API_BASE_URL=/api
